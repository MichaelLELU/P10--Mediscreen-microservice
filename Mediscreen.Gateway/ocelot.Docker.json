{
  "Routes": [
    {
      "UpstreamPathTemplate": "/gateway/auth/login",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamPathTemplate": "/api/auth/login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "authentication-service",
          "Port": 8080
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/gateway/patients",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "DownstreamPathTemplate": "/api/Patients",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "patient-service",
          "Port": 8080
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ]
      }
    },
    {
      "UpstreamPathTemplate": "/gateway/patients/{id}",
      "UpstreamHttpMethod": [ "GET", "PUT" ],
      "DownstreamPathTemplate": "/api/Patients/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "patient-service",
          "Port": 8080
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ]
      }
    },
    {
      "UpstreamPathTemplate": "/gateway/notes",
      "UpstreamHttpMethod": [ "POST" ],
      "DownstreamPathTemplate": "/api/Notes",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "note-service",
          "Port": 8080
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ]
      }
    },
    {
      "UpstreamPathTemplate": "/gateway/notes/patient/{patientId}",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/api/Notes/patient/{patientId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "note-service",
          "Port": 8080
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ]
      }
    },
    {
      "UpstreamPathTemplate": "/gateway/notes/{id}",
      "UpstreamHttpMethod": [ "GET", "PUT", "DELETE" ],
      "DownstreamPathTemplate": "/api/Notes/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "note-service",
          "Port": 8080
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ]
      }
    },
    {
      "UpstreamPathTemplate": "/gateway/risk/{patientId}",
      "UpstreamHttpMethod": [ "GET" ],
      "DownstreamPathTemplate": "/api/Risk/{patientId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "risk-service",
          "Port": 8080
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ]
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:7280"
  }
}
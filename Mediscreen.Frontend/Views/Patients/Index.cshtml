@model IEnumerable<Mediscreen.Frontend.Models.PatientViewModel>

@{
    ViewData["Title"] = "Patients";
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Liste des patients</h1>

    <a asp-controller="Patients"
       asp-action="Create"
       class="btn btn-primary">
        Ajouter un patient
    </a>
</div>

@if (ViewBag.ErrorMessage is not null)
{
    <div class="alert alert-danger">
        @ViewBag.ErrorMessage
    </div>
}
else if (!Model.Any())
{
    <div class="alert alert-info">
        Aucun patient enregistré.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Date de naissance</th>
                <th>Genre</th>
                <th>Adresse</th>
                <th>Téléphone</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var patient in Model)
            {
                <tr>
                    <td>@patient.LastName</td>
                    <td>@patient.FirstName</td>
                    <td>@patient.DateOfBirth.ToString("dd/MM/yyyy")</td>
                    <td>@patient.Gender</td>
                    <td>@(patient.Address ?? "Non renseignée")</td>
                    <td>@(patient.PhoneNumber ?? "Non renseigné")</td>
                    <td class="text-nowrap">
                        <a asp-controller="Patients"
                           asp-action="Details"
                           asp-route-id="@patient.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Détails
                        </a>

                        <a asp-controller="Patients"
                           asp-action="Edit"
                           asp-route-id="@patient.Id"
                           class="btn btn-sm btn-outline-primary">
                            Modifier
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
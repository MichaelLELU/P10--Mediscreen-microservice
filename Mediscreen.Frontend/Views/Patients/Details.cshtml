@model Mediscreen.Frontend.Models.PatientViewModel

@{
    ViewData["Title"] = "Détail du patient";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Détail du patient</h1>

    <a asp-controller="Patients"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Retour à la liste
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h4 mb-4">
            @Model.FirstName @Model.LastName
        </h2>

        <dl class="row mb-0">
            <dt class="col-sm-4">Nom</dt>
            <dd class="col-sm-8">@Model.LastName</dd>

            <dt class="col-sm-4">Prénom</dt>
            <dd class="col-sm-8">@Model.FirstName</dd>

            <dt class="col-sm-4">Date de naissance</dt>
            <dd class="col-sm-8">
                @Model.DateOfBirth.ToString("dd/MM/yyyy")
            </dd>

            <dt class="col-sm-4">Genre</dt>
            <dd class="col-sm-8">@Model.Gender</dd>

            <dt class="col-sm-4">Adresse</dt>
            <dd class="col-sm-8">
                @(Model.Address ?? "Non renseignée")
            </dd>

            <dt class="col-sm-4">Téléphone</dt>
            <dd class="col-sm-8">
                @(Model.PhoneNumber ?? "Non renseigné")
            </dd>
        </dl>
    </div>

    <div class="card-footer">
        <a asp-controller="Patients"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Modifier le patient
        </a>
    </div>
</div>